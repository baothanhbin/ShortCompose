<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lớp 1: Viền Gradient ngoài (Radius = 20dp) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#5E3336"
                android:endColor="#3A0508" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Lớp 2: Nền trong (Thu nhỏ 1dp, Radius = 19dp) -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#3A0508" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</layer-list>